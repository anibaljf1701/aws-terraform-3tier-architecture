# Ejemplo de configuración de backend S3 para entornos de producción
# Este archivo reemplaza al backend.tf actual que usa backend local

terraform {
  backend "s3" {
    # Nombre del bucket S3 (debe existir previamente)
    bucket = "nombre-de-tu-bucket-terraform-state"
    
    # Ruta dentro del bucket para el archivo de estado
    key = "aws-terraform-3tier-architecture/terraform.tfstate"
    
    # Región donde está el bucket
    region = "us-west-2"
    
    # Tabla DynamoDB para bloqueo de estado (opcional, recomendado para equipos)
    # dynamodb_table = "terraform-state-lock"
    
    # Encriptación del estado
    encrypt = true
    
    # Usar archivo de bloqueo (nuevo enfoque recomendado)
    use_lockfile = true
    
    # ACL (opcional)
    # acl = "private"
  }
}

# Instrucciones para crear el bucket S3:
# 
# 1. Crear bucket S3:
#    aws s3api create-bucket --bucket nombre-de-tu-bucket-terraform-state --region us-west-2 --create-bucket-configuration LocationConstraint=us-west-2
# 
# 2. Habilitar versionado:
#    aws s3api put-bucket-versioning --bucket nombre-de-tu-bucket-terraform-state --versioning-configuration Status=Enabled
# 
# 3. Habilitar encriptación:
#    aws s3api put-bucket-encryption --bucket nombre-de-tu-bucket-terraform-state --server-side-encryption-configuration '{"Rules": [{"ApplyServerSideEncryptionByDefault": {"SSEAlgorithm": "AES256"}}]}'
# 
# 4. Configurar políticas de ciclo de vida (opcional):
#    aws s3api put-bucket-lifecycle-configuration --bucket nombre-de-tu-bucket-terraform-state --lifecycle-configuration file://lifecycle.json
# 
# 5. Crear tabla DynamoDB para bloqueo (opcional):
#    aws dynamodb create-table --table-name terraform-state-lock --attribute-definitions AttributeName=LockID,AttributeType=S --key-schema AttributeName=LockID,KeyType=HASH --billing-mode PAY_PER_REQUEST
# 
# 6. Aplicar configuración de backend:
#    terraform init -migrate-state